PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nama_db
BASE_URL=http://localhost:5000
JWT_SECRET=isi_dengan_string_acak_panjang
JWT_EXPIRES_IN=7d
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@pantar.local
ADMIN_PASSWORD=GantiPasswordIni123

# --- Routing (semua opsional, nilai di bawah adalah default-nya) ---
# Server OSRM publik hanya untuk uji coba. Untuk produksi, jalankan OSRM sendiri dengan data OSM.
OSRM_URL=
OSRM_PROFILE=
# Motor: OSRM tidak punya profil motor, default memakai server mobil
# OSRM_MOTOR_URL=
# OSRM_MOTOR_PROFILE=driving
# Pejalan kaki
OSRM_FOOT_URL=
# OSRM_FOOT_PROFILE=driving
OSRM_TIMEOUT_MS=

# Hanya laporan berstatus ini yang dihindari rute dan ditampilkan di /api/routes/hazards
ROUTING_BLOCK_STATUSES=
# Jarak (meter) rute ke laporan agar dianggap "melewati" kerusakan
ROUTING_BUFFER_METERS=
# Jarak (meter) titik belok dari lokasi kerusakan saat memutar
ROUTING_DETOUR_METERS=
ROUTING_MAX_ITER=
ROUTING_PENALTY_SEC=
ROUTING_MAX_DETOUR_FACTOR=

# Tingkat kerusakan yang MASIH BISA dilewati tiap kendaraan (pisahkan dengan koma)
ROUTING_PASSABLE_MOBIL=
ROUTING_PASSABLE_MOTOR=
ROUTING_PASSABLE_JALAN_KAKI=
# --- Validasi laporan otomatis (lihat README: "Validasi laporan otomatis") ---
# Kunci OpenRouter. Kosong = tahap AI dilewati (aturan non-AI tetap berjalan).
OPENROUTER_API_KEY=
# AI_VALIDATION_ENABLED=true
# Urutan model (dicoba berurutan jika error/rate limit). Hanya model yang menerima gambar.
# AI_VISION_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free
# AI_TIMEOUT_MS=25000
# AI_MAX_IMAGES=2
# AI_MIN_CONFIDENCE=0.6
# Mode AI: inline | background | queue. Default: queue di Vercel, background di server biasa.
# AI_VALIDATION_MODE=
# Rahasia untuk Vercel Cron memanggil GET /api/validation/process
CRON_SECRET=

# Ambang skor (0-100): >= AUTO_VERIFY_MIN -> auto_verified, >= REVIEW_MIN -> needs_review, selain itu flagged
# VALIDATION_AUTO_VERIFY_MIN=70
# VALIDATION_REVIEW_MIN=40
# Maksimal laporan per device per jam (per IP: 3x lipat)
# VALIDATION_MAX_PER_HOUR=10
# Radius (meter): foto sama dianggap duplikat / laporan sejenis dianggap kemungkinan duplikat
# VALIDATION_DUP_IMAGE_RADIUS_M=150
# VALIDATION_DUP_NEAR_RADIUS_M=25
# Selisih GPS foto (EXIF) vs titik laporan: cocok <= MATCH_M, janggal > MISMATCH_M
# VALIDATION_EXIF_MATCH_M=150
# VALIDATION_EXIF_MISMATCH_M=500
# Titik laporan jenis "jalan" harus berada paling jauh ini dari jalan (OSRM)
# VALIDATION_ROAD_MAX_M=60

# Batas ukuran upload per file (MB). Field "images" menerima gambar, audio, dan video.
# UPLOAD_MAX_IMAGE_MB=5
# UPLOAD_MAX_AUDIO_MB=10
# UPLOAD_MAX_VIDEO_MB=25